{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ReviewRecord",
  "type": "object",
  "required": ["review_id", "result", "snapshot", "gates", "verified_at"],
  "properties": {
    "review_id": {"type": "string", "pattern": "^RVW-[0-9]{8}-[0-9]{3}$"},
    "result": {"enum": ["APPROVED", "APPROVED_WITH_WARNINGS", "CHANGES_REQUIRED", "BLOCKED", "INVALIDATED"]},
    "snapshot": {
      "type": "object",
      "required": ["repository", "git"],
      "properties": {
        "repository": {
          "type": "object",
          "required": ["path", "branch", "repository_id"],
          "properties": {
            "path": {"type": "string"},
            "branch": {"type": "string"},
            "remote": {"type": "string"},
            "repository_id": {"type": "string"}
          }
        },
        "git": {
          "type": "object",
          "required": ["head", "index_tree", "working_tree_fingerprint"],
          "properties": {
            "head": {"type": "string"},
            "base": {"type": "string"},
            "index_tree": {"type": "string"},
            "working_tree_fingerprint": {"type": "string"}
          }
        },
        "scope": {"type": "object"},
        "profiles": {"type": "array", "items": {"type": "string"}}
      }
    },
    "findings": {"type": "array", "items": {"$ref": "#/definitions/finding"}},
    "gates": {"type": "object"},
    "verified_at": {"type": "string", "format": "date-time"}
  },
  "definitions": {
    "finding": {
      "type": "object",
      "required": ["id", "severity", "gate", "file", "message"],
      "properties": {
        "id": {"type": "string"},
        "severity": {"enum": ["P0", "P1", "P2"]},
        "gate": {"type": "string"},
        "file": {"type": "string"},
        "message": {"type": "string"},
        "required_action": {"type": "string"}
      }
    }
  }
}