{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Finding",
  "type": "object",
  "required": ["id", "severity", "gate", "file", "message"],
  "properties": {
    "id": {"type": "string"},
    "severity": {"enum": ["P0", "P1", "P2"]},
    "gate": {"type": "string", "enum": ["R1", "R2", "R3", "R4", "R5", "R6", "R7", "R8", "R9", "R10"]},
    "category": {"type": "string", "enum": ["scope", "completeness", "consistency", "impact", "architecture", "documentation", "verification", "security", "hygiene", "release"]},
    "file": {"type": "string"},
    "message": {"type": "string"},
    "required_action": {"type": "string"}
  }
}